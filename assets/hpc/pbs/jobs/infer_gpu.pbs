#!/bin/bash
# Inference for the GPU models on every split. Resources: BENCH_QS_INFER_GPU. The device
# name comes from the machine profile (BENCH_GPU_DEVICE).
# ADAPT: the model list.
#PBS -N bench-infer-gpu
#PBS -j oe
set -euo pipefail
# PBS starts the job in $HOME from a copy of this script, so locate env.sh through the
# repo path submit.sh exports with qsub -v.
source "${BENCH_REPO:-$PBS_O_WORKDIR}/${BENCH_HPC:-pbs}/env.sh"
bench_activate
bench_gpu_info

for split in $BENCH_SPLITS; do
    for model in model_a model_b; do
        python -m benchpkg.predict --model "$model" --cache-dir "$BENCH_CACHE" --split "$split" \
            --weights-dir "$BENCH_WEIGHTS" --device "$BENCH_GPU_DEVICE" \
            --out "$BENCH_RESULTS/$split/predictions_$model.csv"
    done
done
