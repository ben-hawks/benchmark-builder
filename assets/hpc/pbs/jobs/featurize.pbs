#!/bin/bash
# (Optional) Preprocess each split once into $BENCH_CACHE, in whatever format the
# benchmark's cache module writes. Drop this job if the benchmark reads raw data directly.
# Resources: BENCH_QS_FEATURIZE in the machine profile (passed by submit.sh).
#PBS -N bench-featurize
#PBS -j oe
set -euo pipefail
# PBS starts the job in $HOME from a copy of this script, so locate env.sh through the
# repo path submit.sh exports with qsub -v.
source "${BENCH_REPO:-$PBS_O_WORKDIR}/${BENCH_HPC:-pbs}/env.sh"
bench_activate
mkdir -p "$BENCH_CACHE"

for split in $BENCH_SPLITS; do
    python -m benchpkg.cache --data-root "$BENCH_DATA" --split "$split" \
        --cache-dir "$BENCH_CACHE" --workers "${NCPUS:-1}"
done
